# Stockage local de démonstration : aucune donnée réelle de Framatex
FRAMATEX_DATA_DIR=./data
# Production : renseigner une clé secrète aléatoire de 32 caractères minimum
# FRAMATEX_SECRET_KEY=...
# DATABASE_URL=postgresql+psycopg://user:password@localhost/framat
# FRAMATEX_COOKIE_SECURE=1  # OBLIGATOIRE derrière HTTPS
# Origine approuvée pour les étiquettes QR. Par défaut : http://127.0.0.1:8000
# FRAMATEX_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Pour un pilote : nouveaux lancements restreints dès la création (0/1)
FRAMATEX_RESTRICT_NEW_LAUNCHES=0

# PREPARATION FUTURE demo Vercel / Supabase — uniquement avec un projet ISOLE
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@[transaction-pooler-host]:6543/postgres?sslmode=require
# FRAMATEX_SECRET_KEY=<cle aleatoire de 48 caracteres ou plus>
# FRAMATEX_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<cle secret serveur, jamais dans un fichier suivi par Git>
# SUPABASE_STORAGE_BUCKET=framat-documents
# FRAMATEX_COOKIE_SECURE=1
# FRAMATEX_PUBLIC_BASE_URL=https://<vercel-domain>
# FRAMATEX_RESTRICT_NEW_LAUNCHES=1
