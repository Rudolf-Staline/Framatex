# Stockage local de démonstration : aucune donnée réelle de Framatex
FRAMATEX_DATA_DIR=./data
# Production : renseigner une clé secrète aléatoire de 32 caractères minimum
# FRAMATEX_SECRET_KEY=...
# DATABASE_URL : SQLite uniquement pour le migrateur actuel. PostgreSQL non validé.
# FRAMATEX_COOKIE_SECURE=1  # OBLIGATOIRE derrière HTTPS
# Origine approuvée pour les étiquettes QR. Par défaut : http://127.0.0.1:8000
# FRAMATEX_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Pour un pilote : nouveaux lancements restreints dès la création (0/1)
FRAMATEX_RESTRICT_NEW_LAUNCHES=0

# Demo seeds require an explicitly isolated demo installation.
FRAMATEX_MODE=OPERATIONAL
# No external email is sent unless approved configuration enables this worker.
FRAMATEX_EMAIL_ENABLED=0
FRAMATEX_SMTP_HOST=
FRAMATEX_SMTP_PORT=587
FRAMATEX_SMTP_FROM=
FRAMATEX_SMTP_USER=
FRAMATEX_SMTP_PASSWORD=

# Quota cumulé par organisation, versions et pièces jointes comprises (100 Mio).
FRAMATEX_PARTNER_QUOTA_BYTES=104857600
# disabled signifie AUCUNE analyse malware. required refuse si le scanner échoue.
FRAMATEX_UPLOAD_SCAN_MODE=disabled
FRAMATEX_SCANNER_COMMAND=
# Démonstration isolée seulement : fournir le mot de passe hors Git.
# FRAMATEX_DEMO_PASSWORD=

# Budget privé total, incluant versions et aperçus temporaires (1 Gio par défaut).
FRAMATEX_STORAGE_QUOTA_BYTES=1073741824
# Adaptateur explicite (command ou clamav) ; required refuse si absent/erreur/délai.
FRAMATEX_SCANNER_BACKEND=command
FRAMATEX_SCANNER_TIMEOUT_SECONDS=30
